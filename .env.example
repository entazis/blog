# Metrics Tracking Configuration
# Copy this file to .env.local and adjust values as needed

# Enable/disable metrics tracking (default: true)
NEXT_PUBLIC_METRICS_ENABLED=true

# Metrics API endpoint
NEXT_PUBLIC_METRICS_API_URL=/api/track

# Site identifier for metrics
NEXT_PUBLIC_SITE_NAME=blog.entazis.dev

# Sample rate for tracking (0-1, default: 1.0 = 100%)
NEXT_PUBLIC_METRICS_SAMPLE_RATE=1.0

# Public site base URL (used for canonical URLs, sitemap, RSS, and absolute links)
NEXT_PUBLIC_SITE_URL=https://blog.entazis.dev

# Maximum metrics per batch before sending (default: 10)
NEXT_PUBLIC_METRICS_BATCH_SIZE=10

# Interval between batch submissions in ms (default: 5000)
NEXT_PUBLIC_METRICS_BATCH_INTERVAL=5000

# Enable debug logging (default: false)
NEXT_PUBLIC_METRICS_DEBUG=false
